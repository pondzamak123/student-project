{
  "info": {
    "name": "Student Project Tracking Dashboard API",
    "description": "Postman Collection สำหรับทดสอบ API ระบบติดตามโครงงานนักศึกษา",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"thanakorn.w@student.uni.ac.th\",\n  \"password\": \"student123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Teacher",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"somchai.j@uni.ac.th\",\n  \"password\": \"teacher123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@uni.ac.th\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Get All Projects",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Get Project Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects/stats", "host": ["{{base_url}}"], "path": ["projects", "stats"] }
          }
        },
        {
          "name": "Get Project by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects/:id", "host": ["{{base_url}}"], "path": ["projects", ":id"] }
          }
        },
        {
          "name": "Create Project",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"โครงงานใหม่\",\n  \"titleEn\": \"New Project\",\n  \"description\": \"รายละเอียดโครงงาน\",\n  \"studentIds\": [1, 2],\n  \"studentNames\": [\"thanakorn Wongsakul\", \"somsri Kijmanee\"],\n  \"courseCode\": \"CS302\",\n  \"courseName\": \"Software Engineering\",\n  \"teacherId\": 3,\n  \"teacherName\": \"somchai Jaidee\",\n  \"startDate\": \"2026-01-15\",\n  \"dueDate\": \"2026-06-30\",\n  \"tags\": [\"web\", \"react\"],\n  \"tools\": [\"Node.js\", \"MongoDB\", \"MySQL\"]\n}"
            },
            "url": { "raw": "{{base_url}}/projects", "host": ["{{base_url}}"], "path": ["projects"] }
          }
        },
        {
          "name": "Update Project",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"โครงงานที่แก้ไขแล้ว\",\n  \"description\": \"รายละเอียดใหม่\"\n}"
            },
            "url": { "raw": "{{base_url}}/projects/:id", "host": ["{{base_url}}"], "path": ["projects", ":id"] }
          }
        },
        {
          "name": "Update Project Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"grade\": \"A\"\n}"
            },
            "url": { "raw": "{{base_url}}/projects/:id/status", "host": ["{{base_url}}"], "path": ["projects", ":id", "status"] }
          }
        },
        {
          "name": "Delete Project",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects/:id", "host": ["{{base_url}}"], "path": ["projects", ":id"] }
          }
        }
      ]
    },
    {
      "name": "Weekly Reports",
      "item": [
        {
          "name": "Submit Weekly Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"week\": 1,\n  \"description\": \"สัปดาห์นี้ทำการศึกษา requirement และออกแบบ database\",\n  \"progress\": 10,\n  \"tasks\": [\n    { \"task\": \"ศึกษา requirement\", \"done\": true },\n    { \"task\": \"ออกแบบ database\", \"done\": false },\n    { \"task\": \"เริ่ม coding\", \"done\": false }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/projects/:projectId/weekly-reports", "host": ["{{base_url}}"], "path": ["projects", ":projectId", "weekly-reports"] }
          }
        },
        {
          "name": "Get Project with Reports",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects/:projectId", "host": ["{{base_url}}"], "path": ["projects", ":projectId"] }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Add Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"งานดีครับ ทำต่อไปให้ทันกำหนด\"\n}"
            },
            "url": { "raw": "{{base_url}}/projects/:projectId/weekly-reports/:reportId/comments", "host": ["{{base_url}}"], "path": ["projects", ":projectId", "weekly-reports", ":reportId", "comments"] }
          }
        },
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects/:projectId/weekly-reports/:reportId/comments", "host": ["{{base_url}}"], "path": ["projects", ":projectId", "weekly-reports", ":reportId", "comments"] }
          }
        }
      ]
    },
    {
      "name": "Files",
      "item": [
        {
          "name": "Upload Files",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "files", "type": "file", "src": "/path/to/file.pdf" }
              ]
            },
            "url": { "raw": "{{base_url}}/projects/:projectId/files", "host": ["{{base_url}}"], "path": ["projects", ":projectId", "files"] }
          }
        },
        {
          "name": "Delete File",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/projects/:projectId/files/:fileId", "host": ["{{base_url}}"], "path": ["projects", ":projectId", "files", ":fileId"] }
          }
        }
      ]
    },
