# ============================
# Student Project Backend .env
# ============================

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (เปลี่ยนเป็นค่าลับของคุณ)
JWT_SECRET=my_super_secret_jwt_key_change_this_in_production

# ============================
# MySQL Configuration
# ============================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=student_project_db

# ============================
# MongoDB Configuration
# ============================
MONGODB_URI=mongodb://localhost:27017/student_project_db

# ============================
# File Upload (Multer)
# ============================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
